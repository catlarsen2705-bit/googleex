{
  "manifest_version": 3,
  "name": "Udsalgstracker",
  "version": "1.0.0",
  "description": "Track sales on furniture and home decor stores",
  "permissions": [
    "notifications",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://www.jysk.dk/*",
    "https://www.ikea.com/*",
    "https://www.imerco.dk/*",
    "https://www.hmhome.dk/*",
    "https://www.georgjensenmuseet.dk/*",
    "http://localhost:8000/*"
  ],
  "background": {
    "service_worker": "background/background.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Udsalgstracker",
    "default_icon": {
      "16": "assets/icon-16.png",
      "48": "assets/icon-48.png",
      "128": "assets/icon-128.png"
    }
  },
  "icons": {
    "16": "assets/icon-16.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  }
}
